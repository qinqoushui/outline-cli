<Window x:Class="OutlineVsix.Views.DocumentPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择 Outline 文档"
        Width="500" Height="600"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="双击文档打开编辑：" Margin="0,0,0,10" FontWeight="Bold"/>

        <TreeView Grid.Row="1" x:Name="DocTree"
                  MouseDoubleClick="DocTree_MouseDoubleClick"/>

        <TextBlock Grid.Row="1" x:Name="LoadingText" Text="正在加载..." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Gray"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="刷新" Width="80" Height="28" Click="Refresh_Click"/>
            <Button Content="取消" Width="80" Height="28" IsCancel="True" Margin="10,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
