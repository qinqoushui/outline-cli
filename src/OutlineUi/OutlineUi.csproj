<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Assets\icon.ico" />
    <EmbeddedResource Include="Assets\icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AtomUI.Desktop.Controls.DataGrid" Version="6.0.7" />
    <PackageReference Include="Avalonia" Version="12.0.5" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.5" />
    <PackageReference Include="AtomUI.Desktop.Controls" Version="6.0.7" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="CodeWF.Markdown" Version="12.0.5.2" />
    <PackageReference Include="CodeWF.Markdown.Themes" Version="12.0.5.2" />
    <PackageReference Condition="'$(Configuration)'=='Debug'" Include="Avalonia.Markup.Xaml.Loader" Version="12.0.5" PrivateAssets="All" Publish="True" />
    <PackageReference Condition="'$(Configuration)'=='Debug'" Include="HotAvalonia" Version="3.1.3" PrivateAssets="All" Publish="True" />
  </ItemGroup>

  <!--<ItemGroup Condition="'$(Configuration)'=='Release'">
    <PackageReference Include="Avalonia.Native" Version="12.0.5" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="4.148.0" />
  </ItemGroup>-->

  <ItemGroup>
    <None Include=".publish\PublishEnigma.csx" />
  </ItemGroup>
</Project>
