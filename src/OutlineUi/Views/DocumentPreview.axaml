<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OutlineUi.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:md="https://codewf.com"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="300"
             x:Class="OutlineUi.Views.DocumentPreview"
             x:DataType="vm:DocumentPreviewViewModel">

  <Design.DataContext>
    <vm:DocumentPreviewViewModel />
  </Design.DataContext>

  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="10">
      <RadioButton Content="预览模式" IsChecked="{Binding IsPreviewMode, Mode=TwoWay}" />
      <RadioButton Content="源码模式" IsChecked="{Binding IsEditMode, Mode=TwoWay}" />
      <Button Command="{Binding SaveCommand}" IsEnabled="{Binding IsModified}">
        <TextBlock Text="保存" />
      </Button>
      <Button Command="{Binding CancelCommand}" IsEnabled="{Binding IsModified}">
        <TextBlock Text="取消" />
      </Button>
    </StackPanel>

    <TextBlock DockPanel.Dock="Bottom" Margin="10" Text="{Binding Document.UpdatedAt, StringFormat='更新时间: {0}'}" />

    <Grid>
      <!-- 预览模式：使用 CodeWF.Markdown 的 MarkdownViewer -->
      <ScrollViewer IsVisible="{Binding IsPreviewMode}"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
        <md:MarkdownViewer Markdown="{Binding SourceText}"
                          TypographyTheme="Simple"
                          TypographySize="Normal" />
      </ScrollViewer>
      
      <!-- 编辑模式：多行文本框 -->
      <Border IsVisible="{Binding IsEditMode}"
              Background="#FFF8E1"
              BorderBrush="#FF9800"
              BorderThickness="2"
              CornerRadius="4"
              Padding="10"
              Margin="10">
        <TextBox Text="{Binding SourceText, Mode=TwoWay}"
                 AcceptsReturn="True"
                 AcceptsTab="True"
                 FontFamily="Consolas"
                 FontSize="14"
                 Background="#E3F2FD"
                 Foreground="#D32F2F"
                 TextWrapping="NoWrap"
                 BorderThickness="2"
                 BorderBrush="#2196F3" />
      </Border>
    </Grid>
  </DockPanel>
</UserControl>
