<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OutlineUi.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:markdown="using:Markdown.Avalonia"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="300"
             x:Class="OutlineUi.Views.DocumentPreview"
             x:DataType="vm:DocumentPreviewViewModel">

  <Design.DataContext>
    <vm:DocumentPreviewViewModel />
  </Design.DataContext>

  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="10">
      <RadioButton Content="预览模式" GroupName="ViewMode" IsChecked="{Binding IsPreviewMode}" />
      <RadioButton Content="源码模式" GroupName="ViewMode" IsChecked="{Binding IsEditMode}" />
      <Button Command="{Binding SaveCommand}" IsEnabled="{Binding IsModified}">
        <TextBlock Text="保存" />
      </Button>
      <Button Command="{Binding CancelCommand}" IsEnabled="{Binding IsModified}">
        <TextBlock Text="取消" />
      </Button>
    </StackPanel>

    <TextBlock DockPanel.Dock="Bottom" Margin="10" Text="{Binding Document.UpdatedAt, StringFormat='更新时间: {0}'}" />

    <Grid>
      <!-- 预览模式：Markdown 渲染 -->
      <markdown:MarkdownScrollViewer IsVisible="{Binding IsPreviewMode}" 
                                     Markdown="{Binding SourceText}"
                                     Margin="10" />
      
      <!-- 编辑模式：多行文本框 -->
      <ScrollViewer IsVisible="{Binding IsEditMode}">
        <TextBox Text="{Binding SourceText, Mode=TwoWay}"
                 AcceptsReturn="True"
                 AcceptsTab="True"
                 FontFamily="Consolas"
                 FontSize="14"
                 Padding="10"
                 BorderThickness="0"
                 Background="Transparent" />
      </ScrollViewer>
    </Grid>
  </DockPanel>
</UserControl>
