<atom:Window xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:atom="https://atomui.net"
             xmlns:vm="using:OutlineUi.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="500"
             x:Class="OutlineUi.Views.UploadListDialog"
             x:DataType="vm:UploadListDialogViewModel"
             Width="800"
             Height="550"
             Title="批量上传文档"
             WindowStartupLocation="CenterScreen">

  <Design.DataContext>
    <vm:UploadListDialogViewModel />
  </Design.DataContext>

  <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="20">
    <TextBlock Grid.Row="0" 
               Text="{Binding StatusMessage}" 
               FontSize="14" 
               FontWeight="Bold"
               Margin="0,0,0,15" />

    <atom:DataGrid x:Name="UploadDataGrid" Grid.Row="1" 
                   ItemsSource="{Binding Files}" 
                   AutoGenerateColumns="False"
                   SelectionMode="Extended"
                   IsFrameBorderVisible="True"
                   CanUserSortColumns="False"
                   CanUserReorderColumns="False"
                   CanUserResizeColumns="False">
      <atom:DataGrid.Columns>
        <atom:DataGridSelectionColumn />
        <atom:DataGridTextColumn Header="文档标题" 
                                 Binding="{Binding DocumentTitle}" 
                                 Width="*" />
        <atom:DataGridTextColumn Header="本地修改时间" 
                                 Binding="{Binding LocalTimeDisplay, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" 
                                 Width="160" />
        <atom:DataGridTextColumn Header="服务器时间" 
                                 Binding="{Binding ServerTimeDisplay, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" 
                                 Width="160" />
        <atom:DataGridTemplateColumn Header="状态" Width="80">
          <atom:DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding StatusText}" 
                         Foreground="{Binding StatusColor}" 
                         FontWeight="Medium"
                         VerticalAlignment="Center" />
            </DataTemplate>
          </atom:DataGridTemplateColumn.CellTemplate>
        </atom:DataGridTemplateColumn>
      </atom:DataGrid.Columns>
    </atom:DataGrid>

    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10" Margin="0,15,0,0">
      <atom:Button Content="全选" Command="{Binding SelectAllCommand}" Width="80" />
      <atom:Button Content="取消全选" Command="{Binding DeselectAllCommand}" Width="100" />
    </StackPanel>

    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="15" HorizontalAlignment="Right" Margin="0,20,0,0">
      <atom:Button Content="上传选中" Command="{Binding UploadSelectedCommand}" Width="100" ButtonType="Primary" />
      <atom:Button Content="全部上传" Command="{Binding UploadAllCommand}" Width="100" ButtonType="Primary" />
    </StackPanel>
  </Grid>
</atom:Window>