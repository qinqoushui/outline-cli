<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OutlineUi.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="300"
        x:Class="OutlineUi.Views.ConflictDialog"
        x:DataType="vm:ConflictDialogViewModel"
        Width="450"
        Height="320"
        Title="文档冲突">

  <Design.DataContext>
    <vm:ConflictDialogViewModel />
  </Design.DataContext>

  <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" Margin="20">
    <TextBlock Grid.Row="0" Text="⚠️" FontSize="24" Margin="0,0,0,10" />
    <TextBlock Grid.Row="1" Text="文档冲突" FontSize="20" FontWeight="Bold" Margin="0,0,0,20" />

    <TextBlock Grid.Row="2">
      <Run Text="文档: " />
      <Run Text="{Binding DocumentTitle}" FontWeight="Bold" />
    </TextBlock>

    <TextBlock Grid.Row="3" Margin="0,10,0,10">
      <Run Text="本地版本: " />
      <Run Text="{Binding LocalTime, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" />
    </TextBlock>

    <TextBlock Grid.Row="4">
      <Run Text="服务器版本: " />
      <Run Text="{Binding ServerTime, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" />
    </TextBlock>

    <TextBlock Grid.Row="5" Text="如何解决？" FontWeight="Bold" Margin="0,20,0,10" />

    <StackPanel Grid.Row="6" Orientation="Vertical" Spacing="10">
      <Button Command="{Binding OverwriteLocalCommand}" HorizontalAlignment="Stretch">
        <TextBlock>
          <Run Text="覆盖本地" />
          <Run Text="- 使用服务器版本" Foreground="Gray" FontSize="12" />
        </TextBlock>
      </Button>

      <Button Command="{Binding OverwriteServerCommand}" HorizontalAlignment="Stretch">
        <TextBlock>
          <Run Text="覆盖服务器" />
          <Run Text="- 使用本地版本" Foreground="Gray" FontSize="12" />
        </TextBlock>
      </Button>

      <Button Command="{Binding SkipCommand}" HorizontalAlignment="Stretch">
        <TextBlock>
          <Run Text="跳过" />
          <Run Text="- 跳过此文档" Foreground="Gray" FontSize="12" />
        </TextBlock>
      </Button>

      <Grid ColumnDefinitions="*,Auto" Margin="0,10,0,0">
        <CheckBox Grid.Column="0" Content="应用到所有" IsChecked="{Binding ApplyToAll}" />
        <Button Grid.Column="1" Command="{Binding CancelCommand}">
          <TextBlock Text="取消" />
        </Button>
      </Grid>
    </StackPanel>
  </Grid>
</Window>
